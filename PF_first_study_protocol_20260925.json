    "reporting": "retain every row and quality class; unresolved is a scientific outcome of this fixed protocol, not a numerical exception"
  },
  "numerical_gates": {
    "source_file_sha256_exact_match": true,
    "source_array_sha256_exact_match": true,
    "state_normalization_absolute": 1e-12,
    "stored_ground_energy_reproduction_hartree": 1e-10,
    "hamiltonian_relative_hermiticity": 1e-12,
    "group_sum_frobenius": 1e-12,
    "pf_unitarity_frobenius": 1e-10,
    "direct_eigenpair_residual_2_norm": 1e-10,
    "U_minus_t_minus_U_t_dagger_relative_frobenius": 1e-10,
    "cpu_gpu_proxy_absolute_hartree_if_both_used": 1e-11,
    "high_precision_two_level_absolute": 1e-12,
    "three_way_closure_hartree": "max(1e-12,1e-8*target_error_hartree)",
    "controlled_state_scalar_quartet_width_absolute": 1e-10,
    "failure_policy": "Stop the affected experiment before interpretation. Do not relax a gate after inspecting scientific results."
  },
  "phase_boundary": {
    "phase_A_name": "selector_freeze",
    "phase_A_allowed": [
      "verified source Hamiltonian and ordered groups",
      "designated input state vector",
      "approximate-state training proxy",
      "PF coefficients and expanded cost",
      "target error",
      "predeclared numerical-quality diagnostics"
    ],
    "phase_A_forbidden": [
      "exact-ground proxy as selector input",
      "direct PF eigenvalue shift",
      "direct optimum or minimum cost",
      "truth-grid values",
      "past H4 pass/fail labels",
      "Phase-B result files"
    ],
    "oracle_diagnostic_exception": "Controlled states may have been constructed from exact information, but must be labelled oracle mechanism diagnostics and cannot support a practical-selector claim.",
    "phase_A_required_outputs": [
      "protocol.json",
      "source_manifest.json",
      "predictions.json",
      "prediction.sha256",
      "focused_tests.log",
      "git_commit"
    ],
    "commit_boundary_required": true,
    "phase_B_name": "truth_scoring",
    "phase_B_rule": "Load the immutable Phase-A predictions and scorer. Add direct truth and oracle comparators without changing selection, budgets, grids, code, or thresholds.",
    "post_truth_bug_policy": "Preserve the run as invalidated, fix under a new protocol version, and repeat Phase A before reopening truth."
  },
  "resource_metrics": {
    "selected_time_shift": "abs(t_selected/t_direct_grid_best-1)",
    "same_formula_time_regret": "C_direct(selected_formula,t_selected)/min_t C_direct(selected_formula,t)-1",
    "joint_selection_regret": "C_direct(selected_formula,t_selected)/C_ref_grid-1",
    "frozen_budget": "B_gamma=gamma*C_predicted",
    "phase_estimation_error": "epsilon_PE=beta*K/(t_selected*B_gamma)",
    "energy_margin": "S_E=epsilon_E-abs(delta_direct(t_selected))-epsilon_PE",
    "success": "S_E>=0",
    "reference_policy": "Include every fixed formula with branch-reliable feasible direct points even when its model fit fails. Exclude branch-unstable points, not model-failing formulae."
  },
  "stopping_rules": {
    "complete_after": [
      "S0 exact-time scoring is closed or explicitly reported as failed without altering old predictions",
      "Experiment A passes all implementation gates",
      "Experiments B and C produce the fixed decomposition and resource tables",
      "one of outcomes A, B, or C below is identified, or none is identified and that null result is reported"
    ],
    "outcomes": {
      "A": "one error component clearly dominates on the fixed normalized comparisons",
      "B": "the dominant component changes across the fixed PF/state/intervention conditions",
      "C": "proxy or model error is material while the frozen resource decision remains robust"
    },
    "dominance_rule": "A component is dominant only when it is at least 3 times each other component at a majority of resolved evaluation points for the same fixed case; otherwise classify as mixed.",
    "resource_robust_rule": "joint selection regret<=0.10 and S_E>=0 at gamma=1.01 despite max(E_fit,E_state,E_proxy)>=0.05*epsilon_E at the selected or nearest fixed evaluation point",
    "must_stop_before": [
      "adding molecules",
      "searching PF coefficients",
      "selecting an improved calibration method",
      "claiming molecular transfer",
      "starting strategy stage S3"
    ]
  },
  "required_outputs": [
    "protocol.json",
    "source_manifest.json",
    "observables.csv",
    "error_decomposition.csv",
    "state_diagnostics.csv",
    "operator_diagnostics.csv",
    "signal_quality.csv",
    "predictions.json",
    "prediction.sha256",
    "allocation_scoring.csv",
    "branch_audit.csv",
    "resources.csv",
    "audit.json",
    "manifest.json",
    "report.md"
  ],
  "completion_policy": {
    "complete_marker": "COMPLETE",
    "complete_allowed_only_if": [
      "source identity passes",
      "Experiment A numerical validation passes",
      "Phase A and Phase B commits are distinct and recorded",
      "all required rows and hashes reconcile",
      "no post-truth selector or scorer modification occurred"
    ],
    "scientific_failure_is_reportable": true,
    "numerical_validation_failure_is_not_a_scientific_result": true
  }
